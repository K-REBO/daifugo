{
  "name": "deno-lisp-interpreter",
  "version": "0.1.0",
  "description": "JavaScript-based Lisp interpreter for running existing LispDaifugoEngine code in browser/Deno",
  "author": "Claude",
  "license": "MIT",
  "exports": "./src/main.ts",
  "tasks": {
    "start": "deno run --allow-read --allow-write src/main.ts",
    "test": "deno test --allow-read --allow-write test/",
    "dev": "deno run --allow-read --allow-write --watch src/main.ts",
    "load-lisp": "deno run --allow-read --allow-write src/main.ts ../LispDaifugoEngine/src/core/card-system.lisp"
  },
  "imports": {
    "@std/assert": "https://deno.land/std@0.208.0/assert/mod.ts",
    "@std/path": "https://deno.land/std@0.208.0/path/mod.ts"
  },
  "compilerOptions": {
    "strict": true,
    "target": "ES2022"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}