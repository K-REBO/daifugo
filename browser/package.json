{
  "name": "daifugo-browser",
  "version": "1.0.0",
  "description": "Browser-based Daifugo game with Lisp rule engine",
  "main": "index.html",
  "scripts": {
    "build-css": "tailwindcss -i ./css/input.css -o ./css/output.css --watch",
    "build": "tailwindcss -i ./css/input.css -o ./css/output.css --minify",
    "serve": "python -m http.server 8080",
    "dev": "concurrently \"npm run build-css\" \"npm run serve\"",
    "test": "playwright test",
    "test:watch": "playwright test --watch"
  },
  "keywords": ["daifugo", "card-game", "lisp", "browser"],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "tailwindcss": "^3.4.0",
    "concurrently": "^8.2.0",
    "@playwright/test": "^1.40.0"
  }
}